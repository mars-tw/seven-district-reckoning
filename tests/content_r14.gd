extends "content_r13.gd"
## R14: source authorship, contrast, real drag/drop and fixed street exhibits.
func run() -> void:
	Engine.set_meta("seven_district_no_records",true)
	game = Main.new(); root.add_child(game)
	while not game.expansion_complete: await process_frame
	game.is_test_mode = true; game._new_game(); game.set_process(false); game.player.set_physics_process(false)
	var panel: CanvasLayer = game.investigation_panel
	for viewport: Vector2i in [Vector2i(390,844),Vector2i(320,568),Vector2i(568,320),Vector2i(844,390),Vector2i(1024,768)]:
		root.size = viewport; root.content_scale_size = viewport
		ready("second_help"); panel.page = "inspect"; panel.show_page(); await settle()
		press_text("案號：岸七"); await settle()
		check(game.investigations.feedback == "這是案號，不是收費條件。","r14_wrong_sentence_no_answer")
		press_text("承諾：本案協助不收任何預付費。"); await settle(); layout("r14_full_original_mark")
		if viewport.y >= 400: check(JSON.stringify(panel.diagnostics().labels).contains("已標 1／2"),"r14_visible_count_with_full_context")
		game.investigations.cite(1,2); game.investigations.compare_choice(0); game.investigations.choose_action(1)
		panel.page = "solve"; panel.show_page(); await settle()
		var state: Dictionary = game.investigations.to_dict(); panel.open_original(1); await settle()
		press_text("收起原件，返回判定"); await settle()
		check(state == game.investigations.to_dict(),"r14_source_reopen_preserves_error_and_highlights")
		game.investigations.choose_action(2); panel.show_page(); await settle(); layout("r14_second_error")
		game.investigations.choose_action(0); panel.show_page(); await settle(); persisted("r14_fee")
		var field: Node3D = game.get_node("InvestigationField"); field._process(0)
		var fixed: Transform3D = field.result_root.global_transform
		game.player.global_position += Vector3(2,0,0); game.player.reset_view(.5); field._process(0)
		check(fixed.is_equal_approx(field.result_root.global_transform),"r14_display_never_follows_camera")
		check(field.result_root.has_node("WallMountedArchiveBoard"),"r14_papers_have_physical_support")
		ready("before_night")
		for i: int in 3: game.investigations.place_time(i,i)
		game.investigations.choose_relation(0,0); game.investigations.choose_relation(1,1); game.investigations.verify_time()
		panel.page = "solve"; panel.show_page(); await settle()
		var diagram: Control = panel.surface.find_child("RevealedDocumentLinks",true,false)
		if viewport.y >= 400: check(not diagram.time_confirmed,"r14_no_match_before_time_uncovered")
		check(not game.investigations.feedback.contains("相符"),"r14_no_premature_time_result")
		game.investigations.reveal_time(1,3); panel.show_page(); await settle()
		if viewport.y >= 400:
			diagram = panel.surface.find_child("RevealedDocumentLinks",true,false)
			check(diagram.reveal_steps == [0,3,0] and not diagram.time_confirmed,"r14_uncovering_middle_does_not_reveal_first_or_match")
		for i: int in 3: game.investigations.reveal_time(i,3)
		panel.show_page(); await settle(); layout("r14_revealed")
		check(panel.surface.find_child("RevealedDocumentLinks",true,false).time_confirmed if viewport.y >= 400 else true,"r14_match_only_after_all_revealed")
		press_text("17：42\n點選拿起收據"); await settle()
		press_text("18：00\n拖到此處"); await settle()
		check(not game.investigations.entry().complete,"r14_target_tap_cannot_complete")
		drag_attachment(false); await settle(); layout("r14_drop_rejected")
		check(not game.investigations.entry().complete and panel.notice.begins_with("位置不對"),"r14_wrong_drop_returns_with_feedback")
		drag_attachment(); await settle(); layout("r14_drop_sealed"); persisted("r14_receipt")
		check(game.investigations.entry().complete,"r14_drag_drop_completes")
		ready("three_voices"); game.investigations.begin_pin_review(); panel.pin_index = 1; panel.page = "judgement"; panel.show_page(); await settle(); layout("r14_judgement")
		if viewport.y >= 400:
			check(panel.surface.find_child("JudgementTimeAxis",true,false) != null,"r14_axis_in_judgement")
			var candidates: Array = panel.diagnostics().buttons.filter(func(b: Dictionary) -> bool: return b.text.begins_with("林秀蘭｜") or b.text.begins_with("陳奕廷｜") or b.text.begins_with("吳安琪｜"))
			check(candidates.size() == 3 and candidates.all(func(b: Dictionary) -> bool: return not b.disabled and b.color == "16181dff" and b.background == "f1e8d5ff"),"r14_readable_enabled_candidates")
			for b: Dictionary in candidates: check(not b.text.contains("17：50") and not b.text.contains("18：10"),"r14_candidates_do_not_preassign_evidence")
		press_text("支持吳安琪：\n前後都有"); await settle()
		check(panel.diagnostics().buttons.any(func(b: Dictionary) -> bool: return b.text == "釘上 前後合看" and b.disabled),"r14_only_pin_disabled_without_two_sources")
		game.investigations.reference_support(0); game.investigations.reference_support(2)
		for i: int in 3: game.investigations.choose_pin(i,[1,2,0][i]); game.investigations.pin_record(i)
		game.investigations.seal_records(); panel.page = "chain"; panel.show_page(); await settle(); layout("r14_authorship_chain"); persisted("r14_voices")
		var ink := JSON.stringify(panel.diagnostics().labels)
		check(ink.contains("林秀蘭記收件") and ink.contains("陳奕廷記收件") and ink.contains("未記發言"),"r14_authorship_is_not_testimony")
		field._process(0)
		check(field.result_papers[0].position.x < field.boundary_ink.position.x and field.boundary_ink.position.x < field.result_papers[1].position.x,"r14_display_time_order")
		check(field.boundary_ink.text.contains("非原件"),"r14_boundary_not_fabricated_evidence")
	panel.close(); game.queue_free(); await settle()
	print("CONTENT_R14_CHECKS=%d FAILURES=%d" % [checks,failures]); quit(0 if failures == 0 else 1)
