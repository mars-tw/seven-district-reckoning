      "objectives": [
        {"key": "sign", "text": "修復早餐店門口的燈箱。", "event": "repair_item", "targets": ["SIDE_012_breakfast_sign"], "required": 1, "world_kind": "repair"},
        {"key": "box", "text": "從綠帶取回互助箱。", "event": "collect_item", "targets": ["SIDE_012_aid_box"], "required": 1, "world_kind": "item"},
        {"key": "shelf", "text": "把互助箱放好，整理安全屋的桌椅。", "event": "repair_item", "targets": ["SIDE_012_safe_corner"], "required": 1, "world_kind": "repair"}
      ]
    },
