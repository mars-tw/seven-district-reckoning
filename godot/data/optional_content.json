  "notes": [
    "本版實作六個支線與四個活動，其餘企劃尚未製作。",
    "可選內容另存零件券與社區成果，不改第一章主線分數或四人救援上限。",
    "活動首次完成領一次獎勵；重玩只更新個人最佳。街景每點首次另領一次。",
    "世界必須先確認交通工具、距離、碰撞與停車條件，才能發出對應事件。"
  ],
  "tasks": [
    {
      "id": "SIDE-001", "type": "side", "title": "招牌不會自己倒", "repeatable": false,
      "summary": "把名品街三塊招攬看板關掉，免得又有人照著地址找來。",
      "dialogue": "美晴：店門上的那塊你處理了，巷口還有三塊。有人連電話都記下來了。\n阿遠：我去把電關掉，收好那幾張廣告。",
      "completion_dialogue": "美晴：這幾張先留著。我貼張真的修車價目表，別再讓人以為這裡能投資。",
      "reward": {"parts_vouchers": 120, "evidence_score": 0, "community_trust": 0, "rescued_bonus": 0, "achievement": "signs_off"},
      "objectives": [
        {"key": "signs", "text": "關閉三塊支線招攬看板。", "event": "disable_sign", "targets": ["SIDE_001_sign_1", "SIDE_001_sign_2", "SIDE_001_sign_3"], "required": 3, "world_kind": "sign"},
        {"key": "report", "text": "回到車店旁的美晴委託桌，把廣告交給她。", "event": "deliver_item", "targets": ["SIDE_001_mei"], "required": 1, "world_kind": "contact"}
      ]
    },
    {
      "id": "SIDE-004", "type": "side", "title": "沒寄出去的信", "repeatable": false,
      "summary": "找回散在接待站外與綠帶的三封信，交給予安整理。",
      "dialogue": "予安：信封都沒貼郵票。他們大概只想寫給家裡，卻不知道怎麼寄。\n阿遠：你等我一下。那張長椅底下好像還有一封。",
      "completion_dialogue": "予安：這封寫到一半就停了。名字我先記下來，其他的，等他願意說。",
      "reward": {"parts_vouchers": 130, "evidence_score": 8, "community_trust": 0, "rescued_bonus": 0, "achievement": "letters_returned"},
      "objectives": [
        {"key": "letters", "text": "找回三封故事信件；每封只算一次。", "event": "collect_evidence", "targets": ["SIDE_004_letter_1", "SIDE_004_letter_2", "SIDE_004_letter_3"], "required": 3, "world_kind": "evidence"},
        {"key": "deliver", "text": "把信交給綠帶邊的予安。", "event": "deliver_item", "targets": ["SIDE_004_yuan"], "required": 1, "world_kind": "contact"}
      ]
    },
    {
      "id": "SIDE-007", "type": "side", "title": "沒拿回來的背包", "repeatable": false,
