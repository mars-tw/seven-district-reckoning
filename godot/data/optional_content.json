        {"key": "deliver", "text": "騎自行車把餐盒送到兩個街坊收件點。", "event": "deliver_by_bike", "targets": ["SIDE_011_neighbor_1", "SIDE_011_neighbor_2"], "required": 2, "world_kind": "bike_contact", "vehicle": "bicycle"},
        {"key": "report", "text": "回早餐店告訴素蓉都已送達。", "event": "deliver_item", "targets": ["SIDE_011_surong"], "required": 1, "world_kind": "contact"}
      ]
    },
    {
      "id": "SIDE-012", "type": "side", "title": "把早餐店開回來", "repeatable": false,
      "summary": "補好早餐店招牌，把互助箱搬回去，再整理安全屋角落。",
      "dialogue": "素蓉：燈不亮，大家就以為沒開。互助箱被搬去綠帶了，你順路拿回來就好。\n阿遠：桌角那堆紙箱也整理一下。明天有人來，至少有地方坐。",
      "completion_dialogue": "素蓉：好啦，招牌亮了。明早六點，想吃就來，先吃了再說。",
