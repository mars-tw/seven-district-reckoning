        {"key": "drops", "text": "把包裹送到三個收件點，順序自選。", "event": "deliver_parcel", "targets": ["ACT_006_drop_1", "ACT_006_drop_2", "ACT_006_drop_3"], "required": 3, "world_kind": "delivery"}
